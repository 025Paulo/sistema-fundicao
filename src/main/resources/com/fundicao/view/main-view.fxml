<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fundicao.controller.MainController"
      styleClass="root-container"
      prefWidth="1100" prefHeight="680">

    <VBox styleClass="sidebar" prefWidth="200" spacing="12">
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <Label text="Fundição" styleClass="sidebar-title"/>
            <Label text="Paraibuna" styleClass="sidebar-title"/>
            <Label text="Sistema de Controle" styleClass="sidebar-subtitle"/>
        </VBox>
        <Separator/>
        <VBox spacing="8" style="-fx-padding: 12 16 0 16;">
            <VBox fx:id="btnEstoque" styleClass="nav-card" onMouseClicked="#abrirEstoque" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2w-warehouse" iconSize="22" styleClass="nav-icon"/>
                    <Label text="Estoque" styleClass="nav-label"/>
                </HBox>
            </VBox>
            <VBox fx:id="btnNotas" styleClass="nav-card" onMouseClicked="#abrirNotas" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2f-file-document-outline" iconSize="22" styleClass="nav-icon"/>
                    <Label text="Notas Fiscais" styleClass="nav-label"/>
                </HBox>
            </VBox>
            <VBox fx:id="btnProdutos" styleClass="nav-card" onMouseClicked="#abrirProdutos" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2c-cube-outline" iconSize="22" styleClass="nav-icon"/>
                    <Label text="Produtos" styleClass="nav-label"/>
                </HBox>
            </VBox>
            <VBox fx:id="btnEntidades" styleClass="nav-card" onMouseClicked="#abrirEntidades" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2a-account-group-outline" iconSize="22" styleClass="nav-icon"/>
                    <Label text="Entidades" styleClass="nav-label"/>
                </HBox>
            </VBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox styleClass="sidebar-footer" alignment="CENTER">
            <Label text="v1.0.0" styleClass="sidebar-version"/>
        </VBox>
    </VBox>

    <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS" styleClass="content-area"/>

</HBox>