<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fundicao.controller.NotaFiscalDialogController"
      spacing="16" style="-fx-padding: 24;">

    <Label fx:id="labelTitulo" text="Nova Nota Fiscal"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Natureza *" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <ComboBox fx:id="comboNatureza" prefWidth="180"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Número *" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoNumero" styleClass="text-field"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Data *" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <DatePicker fx:id="campoData" styleClass="date-picker"/>
        </VBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Fornecedor / Cliente" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
        <ComboBox fx:id="comboEntidade" prefWidth="400"/>
    </VBox>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Ordem de compra" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoOrdemCompra" styleClass="text-field"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Transportadora" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoTransportadora" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Frete (R$)" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoTransporteRs" promptText="0,00" styleClass="text-field"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Desconto (R$)" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoDescontoRs" promptText="0,00" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Peso bruto (kg)" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoPesoBruto" promptText="0,00" styleClass="text-field"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Peso líquido (kg)" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="campoPesoLiquido" promptText="0,00" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
        <Button fx:id="btnSalvar" text="Salvar" styleClass="btn-primary" onAction="#salvar"/>
    </HBox>

</VBox>