<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fundicao.controller.EntidadeController"
      spacing="0">

    <VBox styleClass="module-header">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="mdi2a-account-group-outline" iconSize="26" styleClass="nav-icon"/>
            <VBox>
                <Label text="Entidades" styleClass="module-title"/>
                <Label text="Clientes e fornecedores" styleClass="module-subtitle"/>
            </VBox>
        </HBox>
    </VBox>

    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="campoBusca" promptText="Buscar por nome, CNPJ ou e-mail..."
                   prefWidth="300" styleClass="text-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Adicionar" styleClass="btn-primary" onAction="#adicionar"/>
    </HBox>

    <Region prefHeight="16"/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colRazaoSocial" text="Razão Social"  prefWidth="320"/>
            <TableColumn fx:id="colTipo"        text="Tipo"          prefWidth="120"/>
            <TableColumn fx:id="colCnpjCpf"     text="CNPJ / CPF"   prefWidth="160"/>
            <TableColumn fx:id="colTelefone"    text="Telefone"      prefWidth="140"/>
            <TableColumn fx:id="colSituacao"    text="Situação"      prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Nenhuma entidade cadastrada."
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <!-- Painel de detalhes (começa oculto) -->
    <VBox fx:id="painelDetalhes" styleClass="detalhe-painel" managed="false" visible="false">
        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="detalhe-header">
            <FontIcon iconLiteral="mdi2i-information-outline" iconSize="14"
                      style="-fx-fill: #6B7280;"/>
            <Label fx:id="labelNomeDetalhe" styleClass="detalhe-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnFecharDetalhe" text="✕" styleClass="btn-fechar"
                    onAction="#fecharDetalhes"/>
        </HBox>

        <GridPane hgap="24" vgap="6" styleClass="detalhe-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <!-- Linha 0: labels -->
            <Label text="Telefone"      style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="E-mail"        style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="CNPJ / CPF"    style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label text="Insc. Estadual" style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Linha 1: valores -->
            <Label fx:id="dTelefone" styleClass="detalhe-valor" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="dEmail"    styleClass="detalhe-valor" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label fx:id="dCnpj"     styleClass="detalhe-valor" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Label fx:id="dIe"       styleClass="detalhe-valor" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Linha 2: labels endereço -->
            <Label text="Endereço"   style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
            <Label text="Cidade / UF" style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Label text="CEP"         style="-fx-text-fill:#9CA3AF; -fx-font-size:11px;" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Linha 3: valores endereço -->
            <Label fx:id="dEndereco" styleClass="detalhe-valor" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
            <Label fx:id="dCidade"   styleClass="detalhe-valor" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <Label fx:id="dCep"      styleClass="detalhe-valor" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
        </GridPane>
    </VBox>

    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="16"
          style="-fx-padding: 10 16 10 16;">
        <Label fx:id="labelTotal"
               style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
               text="Total: 0 registros"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Alterar" styleClass="btn-secondary" onAction="#alterar"/>
        <Button text="Excluir" styleClass="btn-danger"    onAction="#excluir"/>
    </HBox>

</VBox>